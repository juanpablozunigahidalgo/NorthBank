# Copy to backend/.env locally — NEVER commit real keys.
AWS_REGION=eu-north-1
USE_BEDROCK=false
AI_PROVIDER=auto
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
USE_LIVE_NEWS=true
MAX_COMPANY_EXTERNALITY_QUERIES=10
MAX_PERSON_EXTERNALITY_QUERIES=8
MAX_PERSON_EXTERNALITY_PEOPLE=1
MEDIA_SEARCH_WORKERS=4
MEDIA_TOP_N=12
# After frontend is live, set to your Vercel URL (or keep * for demo)
CORS_ORIGINS=*
